# DailySeed 后端配置样例。
#
# 用法：复制成 backend/.env（已在 .gitignore 里，不要提交），然后按下面改。
#   本地开发：另加一行 DAILYSEED_DEV_MODE=true
#   上线：下面这份就是上线该有的样子
#
# ⚠️ application.yml 里读过这个文件（spring.config.import: optional:file:.env）。
#    用 docker compose 起时，compose 的 env_file 也指同一个文件——**唯一一份配置来源**，
#    本机 mvn 跑和容器跑读的是它。

# ---------- 数据库 ----------
# 本机直接跑（mvn spring-boot:run）：
DB_URL=jdbc:mysql://localhost:3306/dailyseed?characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# 用 docker compose 起时这个值会被 compose 覆盖成 jdbc:mysql://mysql:3306/...（容器里的库不叫 localhost）
DB_USER=root
DB_PASSWORD=change-me           # ⚠️ 上线必须换，而且要和 compose 里的 MYSQL_ROOT_PASSWORD 一致

# ---------- 上线该有的样子（三个开关） ----------

# ① 每天只能抽一次（0 = 无限重抽，那是开发期用来连着看手感与分布的）
DAILYSEED_DRAW_MAX_PER_DAY=1

# ② 不要承认开发模式。
#    它和上一条是连在一起的：配额是 0 却没承认开发模式 → 应用会**拒绝启动**（StartupGuard）。
#    上线时保持这一行**注释掉**，就等于"不可能把无限重抽带上生产"。
# DAILYSEED_DEV_MODE=true

# ③ https 下必须开 secure，否则浏览器可能直接丢弃这条 Cookie，
#    "清掉 localStorage 还能找回"那条退路会**静默失效**（/api/health 会报出来）。
DAILYSEED_SESSION_COOKIE_SECURE=true

# 身份退路总开关。关掉它就没有退路了，只能靠同步码——不建议关。
DAILYSEED_SESSION_COOKIE_ENABLED=true
