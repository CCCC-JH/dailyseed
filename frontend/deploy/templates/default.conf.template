# DailySeed 前端的 nginx 配置（模板）。
#
# ⚠️ 这个文件**不是**直接用的：官方 nginx 镜像启动时会用 envsubst 把 ${...} 替换掉，
# 生成 /etc/nginx/conf.d/default.conf。所以它放在 templates/ 下，后缀是 .template。
#
# 三件事：① 静态文件按类型给对缓存策略 ② /api 反代到后端（同域，所以后端不需要 CORS）
# ③ SPA 回退到 index.html

# ★★ 缓存策略集中成一张表 ★★
#
# 为什么不能像原来那样"在每个 location 里各写一条 add_header Cache-Control"：
#   nginx 的 add_header 是**全有或全无**——只要某个 location 自己写了**任何一条** add_header，
#   server 块里的**所有** add_header 在这个 location 内就全部失效（官方文档原话：
#   "inherited from the previous configuration level **if and only if** there are no
#    add_header directives defined on the current level"）。
#   原来的写法在 /index.html、/assets/、/sw.js、/icons/、/manifest.webmanifest 里各写了一条
#   Cache-Control，于是 **CSP / X-Frame-Options / nosniff / Referrer-Policy 在这些响应上一条都不发**
#   ——恰恰包括最需要 CSP 的 index.html。而且它是**静默失效**：不报错、不可见，
#   只有 curl -I 才看得出来。
#   把"缓存怎么设"变成一张表、location 里一条 add_header 都不写，这个坑就不存在了。
#
# map 必须写在 http 上下文里——conf.d/*.conf 正是被 include 在 http{} 里的，所以放这儿没问题。
map $uri $dailyseed_cache_control {
    default        "no-cache";
    # ★★ Service Worker 绝不能被缓存 ★★
    # 它一旦被缓存住，用户会一直跑旧版本的 SW，新的 index.html 永远换不上——
    # 症状是"我明明发布了，用户却说没变化"，而且刷新也没用。
    /sw.js         "no-cache, no-store, must-revalidate";
    # index.html 同理：它引用的哈希文件名每次发布都在变，缓存住它等于卡住整个升级
    /index.html    "no-cache";
    # 带内容哈希的产物可以放心长缓存（文件名变了就是新文件）
    ~^/assets/     "public, max-age=31536000, immutable";
    ~^/icons/      "public, max-age=604800";
    # ⚠️ /api/ 落在 default（no-cache）上，这是**故意的**：那些响应是某个人的今天/花园，
    #    不该被任何中间层缓存住。
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;
    gzip_min_length 1024;

    # 安全头。这个应用不嵌第三方、不加载外部脚本，所以 CSP 可以收得很紧。
    # 注意 style-src 需要 'unsafe-inline'：React 的行内 style 属性过不了 nonce。
    #
    # ⚠️ 这几条**必须在 server 层、且下面每个 location 都不能再写 add_header**：
    #    见文件开头那段——location 里写一条，这里全部失效。
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header Cache-Control $dailyseed_cache_control always;
    # 只对 /sw.js 有意义（浏览器读它决定 SW 的作用域）。sw.js 就在根目录，默认作用域已经是 /，
    # 所以这条其实是保险；放在这里而不是 location 里，是为了不破坏上面那几条的继承。
    add_header Service-Worker-Allowed "/" always;

    location = /sw.js {
        try_files $uri =404;
    }

    location = /index.html {
        try_files $uri =404;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        types { } default_type application/manifest+json;
        try_files $uri =404;
    }

    location /icons/ {
        try_files $uri =404;
    }

    # 同域反代：前端一律请求相对路径 /api/...，所以后端不需要任何 CORS 配置。
    # 上游地址由环境变量给（compose 里是 http://api:8080）。
    #
    # ⚠️ 这里刻意**不用变量**（不写 proxy_pass $backend）：
    # 用了变量就必须配 resolver，还要处理"后端换 IP 了但 nginx 还记着旧的"。
    # 直写主机名时 nginx 在启动时解析一次并缓存；后端容器换 IP 时，
    # 重启这个容器（compose restart 就会重建）比让 nginx 自己去发现更简单也更可预测。
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 身份只靠 X-Device-Id 请求头，别让 nginx 把它吃掉
        proxy_pass_request_headers on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # SPA 回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}
